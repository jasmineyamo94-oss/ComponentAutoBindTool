  generatedNamespace: 
  parentClassName: 
  eventTemplate: AddEvent(${event_obj}, "${event_name}", ${handler_name});
  removeEventTemplate: ${event_obj}.${event_name}.RemoveAllListeners();
  eventNameRule: On${event_obj}${event_name}
  bindTemplate: "${usings}\n\npublic partial class ${class_name}\n{\n    ${fields}\n\n   
    private void OnEnable()\n    {\n        RegisterEvent();\n    }\n\n    private
    void OnDisable()\n    {\n        UnregisterEvent();\n    }\n\n    private void
    RegisterEvent()\n    {\n        ${add_event_statements}\n    }\n\n    private
    void UnregisterEvent()\n    {\n        ${remove_event_statements}\n    }\n\n   
    public void Bind(GameObject ${root_object})\n    {\n        UnregisterEvent();\n       
    ${find_statements}\n        RegisterEvent();\n    }\n\n    ${event_handlers}\n}\n"
  rootTransform: root
  findTemplate: ${obj_name} = FindChild(${parent_obj}.transform, "${path}", typeof(${component}));
  logicOutputDirectory: Assets/Scripts/Logic
  partialOutputDirectory: Assets/Scripts/Logic/Generated
